# PostgreSQL
PG_USER=admin
PG_PASSWORD=admin123
PG_HOST=localhost
PG_PORT=5432

# Container Docker
CONTAINER=pg-primary

# Replica (untuk transfer file backup)
REPLICA_USER=capstone11
REPLICA_IP=192.168.218.11
REPLICA_BACKUP_DIR=/backup/received
SSH_KEY=$HOME/.ssh/backup_key

# Enkripsi AES-256
BACKUP_AES_PASSPHRASE=capstone11aeskey

# Direktori backup di Primary
BACKUP_DIR=/backup
